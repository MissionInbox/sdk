# Required in every run
MI_API_KEY=
MI_API_URL=https://api-v4-staging.missioninbox.com

# Optional. `safe` (default) skips every write. `full` runs creates/deletes and sends one real email.
MI_EXAMPLE_MODE=safe

# Required in full mode only.
# Must be a registered sending identifier on your account (the example uses it as `from:`).
MI_TEST_SENDER=

# Required in full mode only. A recipient you control — one test email will be delivered here.
MI_TEST_TO=

# Required in full mode only. A domain registered on your account. Used to read domain details
# and to derive test subdomains for the bulk-create demo (nothing is written to your live DNS).
MI_TEST_DOMAIN=

# Optional in full mode. If set, the redirect setup/delete demo runs against this domain.
# Leave blank to only exercise the read-side of `domains.redirects`.
MI_TEST_REDIRECT_DOMAIN=
