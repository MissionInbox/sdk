<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.missioninbox.example</groupId>
  <artifactId>example</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>MissionInbox Java SDK Example</name>
  <description>End-to-end walk-through of the MissionInbox Java SDK</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <!-- Default entrypoint; override with -Dexec.mainClass=com.missioninbox.example.ErrorCatalog -->
    <exec.mainClass>com.missioninbox.example.Main</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.missioninbox</groupId>
      <artifactId>sdk</artifactId>
      <version>0.1.0</version>
    </dependency>

    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>3.0.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <!-- Override with -Dexec.mainClass=com.missioninbox.example.ErrorCatalog to run the error catalog. -->
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
