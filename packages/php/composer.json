{
  "name": "missioninbox/sdk",
  "description": "Official MissionInbox SDK for PHP",
  "type": "library",
  "license": "MIT",
  "keywords": ["missioninbox", "email", "transactional", "sdk"],
  "homepage": "https://github.com/MissionInbox/sdk-php",
  "support": {
    "issues": "https://github.com/MissionInbox/sdk/issues",
    "source": "https://github.com/MissionInbox/sdk-php"
  },
  "authors": [
    { "name": "MissionInbox, Inc." }
  ],
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "MissionInbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MissionInbox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src --level=6"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
